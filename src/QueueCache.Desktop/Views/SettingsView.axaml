<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:QueueCache.Desktop.ViewModels"
             x:Class="QueueCache.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Classes="page" Spacing="4">
      <TextBlock Classes="title" Text="Settings" Margin="0,0,0,12" />

      <TextBlock Classes="section" Text="Appearance" Margin="0,0,0,4" />
      <ui:FASettingsExpander Header="App theme" Description="Light, dark, or the same as Windows">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconWindow}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
          <ComboBox Name="ThemeBox" MinWidth="200" ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding Theme}" AutomationProperties.Name="App theme" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>

      <TextBlock Classes="section" Text="Live values" Margin="0,16,0,4" />
      <ui:FASettingsExpander Header="Update interval" Description="How often live values, charts and visible memory maps update. The 0.1-second option updates ten times per second.">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconActivity}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
          <ComboBox Name="UpdateBox" MinWidth="200" ItemsSource="{Binding UpdateChoices}" SelectedIndex="{Binding UpdateChoice}" AutomationProperties.Name="Update interval" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>

      <TextBlock Classes="section" Text="Notification area" Margin="0,16,0,4" />
      <ui:FASettingsExpander Header="Keep running when the window is closed"
                             Description="QueueCache stays in the notification area with its status and quick actions. Caches and disks keep running either way.">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconInfo}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
          <ToggleSwitch Name="TrayToggle" IsChecked="{Binding KeepRunningInTray}" AutomationProperties.Name="Keep running in the notification area" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>

      <ui:FASettingsExpander Header="Start QueueCache when you sign in" Description="{Binding SignInDescription}">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconStart}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
          <ToggleSwitch Name="SignInToggle" IsChecked="{Binding StartAtSignIn}" IsEnabled="{Binding SignInAvailable}"
                        AutomationProperties.Name="Start QueueCache when you sign in" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
      <TextBlock Classes="error" Text="{Binding SignInError}" TextWrapping="Wrap"
                 IsVisible="{Binding SignInError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Classes="section" Text="Advanced" Margin="0,16,0,4" />
      <ui:FASettingsExpander Name="AdvancedSettings" Header="Developer settings"
                             Description="Measurements and switches for comparing performance. You don't need these for normal use.">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconDiagnostics}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpanderItem Content="Detailed driver timing" Description="{Binding DriverTimingDescription}">
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch Name="TimingToggle" IsChecked="{Binding DriverTiming}" AutomationProperties.Name="Detailed driver timing" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
        <ui:FASettingsExpanderItem Content="Answer cache hits on the calling thread" Description="{Binding CallerPathDescription}">
          <ui:FASettingsExpanderItem.Footer>
            <ToggleSwitch Name="CallerPathToggle" IsChecked="{Binding CallerPath}" AutomationProperties.Name="Answer cache hits on the calling thread" />
          </ui:FASettingsExpanderItem.Footer>
        </ui:FASettingsExpanderItem>
      </ui:FASettingsExpander>

      <TextBlock Classes="section" Text="About" Margin="0,16,0,4" />
      <ui:FASettingsExpander Header="QueueCache" Description="RAM caches for volumes and disks that live in RAM">
        <ui:FASettingsExpander.IconSource><ui:FAPathIconSource Data="{StaticResource IconCache}" /></ui:FASettingsExpander.IconSource>
        <ui:FASettingsExpander.Footer>
          <SelectableTextBlock Classes="secondary" Text="{Binding Version}" VerticalAlignment="Center" />
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
