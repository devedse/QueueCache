<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:QueueCache.Desktop.ViewModels"
             xmlns:ctl="using:QueueCache.Desktop.Controls"
             xmlns:views="using:QueueCache.Desktop.Views"
             x:Class="QueueCache.Desktop.Views.VirtualDisksView"
             x:DataType="vm:VirtualDisksViewModel">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="300,*" Margin="32,24,0,0">
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,32,12">
      <TextBlock Classes="title" Text="Virtual disks" />
      <Button Grid.Column="1" Name="NewDiskButton" Classes="accent" Command="{Binding NewDiskCommand}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconAdd}" />
          <TextBlock Text="New disk" />
        </StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,0,0,24">
      <TextBlock Classes="secondary" Text="{Binding Monitor.VirtualDisksStatus}" Margin="0,0,0,8"
                 IsVisible="{Binding Monitor.VirtualDisksStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ListBox Grid.Row="1" Name="DiskList" ItemsSource="{Binding Monitor.VirtualDisks}" SelectedItem="{Binding Selected}"
               Background="Transparent" AutomationProperties.Name="Virtual disks">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:VirtualDiskViewModel">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <ctl:VolatileBadge Grid.Column="1" IsVisible="{Binding IsVolatile}" />
              <TextBlock Grid.Row="1" Classes="caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{Binding Kind}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <ctl:StatusPill Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Health="{Binding Health}" Text="{Binding StatusText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Selected}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:VirtualDiskViewModel"><views:VirtualDiskDetailsView /></DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="24,0,32,0" Spacing="8" MaxWidth="560" HorizontalAlignment="Left"
                IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
      <TextBlock Classes="subtitle" Text="Disks that live in RAM" />
      <TextBlock Classes="secondary" Text="A RAM disk is the fastest storage there is and starts empty every time. An image in RAM loads a .vhdx file into memory and saves it when you ask. A disk image with a RAM cache keeps its data in a file and uses RAM to speed it up." />
    </StackPanel>
  </Grid>
</UserControl>
