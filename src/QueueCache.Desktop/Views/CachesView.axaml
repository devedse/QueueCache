<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:QueueCache.Desktop.ViewModels"
             xmlns:ctl="using:QueueCache.Desktop.Controls"
             xmlns:fmt="using:QueueCache.Desktop.Formatting"
             xmlns:views="using:QueueCache.Desktop.Views"
             x:Class="QueueCache.Desktop.Views.CachesView"
             x:DataType="vm:CachesViewModel">
  <UserControl.Styles>
    <!-- Disk headers in the volume list are labels, not selectable rows. -->
    <Style Selector="ListBoxItem.header">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,14,12,2" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ListBoxItem.header /template/ ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="300,*" Margin="32,24,0,0">
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,32,12">
      <TextBlock Classes="title" Text="Caches" />
      <Button Grid.Column="1" Name="RefreshButton" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
              ToolTip.Tip="Look for added or removed volumes now" AutomationProperties.Name="Refresh volume list">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{StaticResource IconRefresh}" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
    </Grid>
    <ui:FAInfoBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,32,12" IsClosable="True"
                  IsOpen="{Binding Monitor.HasMessage, Mode=TwoWay}" IsVisible="{Binding Monitor.HasMessage}" Message="{Binding Monitor.Message}"
                  Severity="{Binding Monitor.MessageSeverity, Converter={x:Static fmt:Converters.Severity}}" />

    <!-- Volumes grouped by the physical disk that holds them. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" Margin="0,0,0,24">
      <TextBlock Classes="secondary" Text="{Binding Monitor.VolumesStatus}" Margin="0,0,0,8"
                 IsVisible="{Binding Monitor.VolumesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ListBox Grid.Row="1" Name="VolumeList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
               Background="Transparent" AutomationProperties.Name="Volumes">
        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:DiskGroupViewModel">
            <StackPanel>
              <TextBlock Classes="caption strong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Header}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Hint}"
                         IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate DataType="vm:VolumeViewModel">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,4">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <ctl:VolatileBadge Grid.Column="1" IsVisible="{Binding IsVolatile}" />
              <TextBlock Grid.Row="1" Classes="caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="{Binding KindText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <ctl:StatusPill Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" Health="{Binding Health}" Text="{Binding StatusText}"
                              IsVisible="{Binding ShowStatus}" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
      <!-- Saved settings for volumes that are not connected: no live values exist for them. -->
      <StackPanel Grid.Row="2" Spacing="4" Margin="12,12,12,0"
                  IsVisible="{Binding Monitor.Disconnected.Count, Converter={x:Static fmt:Converters.NotZero}}">
        <TextBlock Classes="caption strong" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Not connected" />
        <ItemsControl Name="DisconnectedList" ItemsSource="{Binding Monitor.Disconnected}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:SavedVolumeViewModel">
              <TextBlock Classes="caption secondary" Text="{Binding Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- The selected volume. -->
    <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding Selected}">
      <ContentControl.ContentTemplate>
        <DataTemplate DataType="vm:VolumeViewModel"><views:VolumeDetailsView /></DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
    <TextBlock Grid.Row="2" Grid.Column="1" Classes="secondary" Margin="24,0,32,0" Text="Select a volume to see its cache."
               IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}" />
  </Grid>
</UserControl>
